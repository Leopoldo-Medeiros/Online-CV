---
import { profile } from "@/content/profile";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import TechPill from "@/components/ui/TechPill.astro";
---

<section id="stack" class="border-b border-border py-20 md:py-28">
  <div class="mx-auto max-w-6xl px-6">
    <SectionHeading index="02" eyebrow="Tech stack" heading="What actually ships to production." />
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      {
        profile.techStack.map((group) => (
          <div>
            <h3 class="mb-4 font-mono text-xs uppercase tracking-widest text-muted">{group.label}</h3>
            <div class="flex flex-wrap gap-2">
              {group.items.map((item) => <TechPill label={item} />)}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
