---
import { profile } from "@/content/profile";
import Button from "@/components/ui/Button.astro";
import TechPill from "@/components/ui/TechPill.astro";

const heroTags = ["Java", "PHP", "OpenTelemetry", "Distributed Tracing"];
const firstName = profile.name.split(" ")[0];

const companies = [
  { name: "New Relic", src: "/images/logos/newrelic.png", card: "dark", imgClass: "max-h-5", w: 400, h: 78 },
  { name: "Hibernian Healthcare", src: "/images/logos/hibernian.png", card: "light", imgClass: "max-h-9", w: 1000, h: 362 },
  { name: "Online Application", src: "/images/logos/onlineapplication.png", card: "light", imgClass: "max-h-7", w: 138, h: 49 },
  { name: "CCT College Dublin", src: "/images/logos/cct.png", card: "light", imgClass: "max-h-6", w: 225, h: 42 },
] as const;
---

<section id="top" class="relative overflow-hidden border-b border-border">
  <svg
    class="pointer-events-none absolute inset-0 hidden h-full w-full opacity-[0.07] md:block"
    aria-hidden="true"
  >
    <line x1="0" y1="18%" x2="52%" y2="18%" stroke="white" stroke-width="1"></line>
    <line x1="0" y1="38%" x2="78%" y2="38%" stroke="white" stroke-width="1"></line>
    <line x1="0" y1="58%" x2="38%" y2="58%" stroke="#E4572E" stroke-width="1"></line>
    <line x1="0" y1="78%" x2="64%" y2="78%" stroke="white" stroke-width="1"></line>
  </svg>

  <div class="relative mx-auto max-w-6xl px-6 pb-14 pt-16 md:pb-20 md:pt-24">
    <div class="grid gap-16 md:grid-cols-[1fr_1fr] md:items-center">
      <div>
        <p class="mb-5 flex items-center gap-2 font-mono text-xs uppercase tracking-widest text-muted">
          <span class="h-1.5 w-1.5 rounded-full bg-ember"></span>
          {profile.location} — Distributed systems & observability
        </p>
        <h1 class="font-display text-4xl font-semibold leading-[1.05] tracking-tight text-ink sm:text-5xl md:text-6xl">
          Backend systems that stay <span class="text-ember">observable</span> at scale.
        </h1>
        <p class="mt-6 max-w-xl text-justify text-base leading-relaxed text-muted md:text-lg">
          I'm {firstName}, a {profile.title.toLowerCase()} at <strong class="font-semibold text-ink">New Relic</strong>{" "}
          specializing in distributed systems performance, API architecture and production observability. Over{" "}
          <strong class="font-semibold text-ink">5+ years</strong>,
          I've kept mission-critical APIs above a <strong class="font-semibold text-ink">95%+ SLA</strong> across{" "}
          <strong class="font-semibold text-ink">3</strong> industries: fintech, healthcare and SaaS.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <Button href="#work" variant="primary">View selected work</Button>
          <Button href="/resume.pdf" variant="secondary" download>Download resume</Button>
        </div>
        <div class="mt-8 flex flex-wrap gap-x-4 gap-y-2 border-t border-border pt-6">
          {heroTags.map((tag) => <TechPill label={tag} />)}
        </div>
      </div>

      <div class="justify-self-center md:justify-self-end">
        <div class="relative w-72 sm:w-80 md:w-[26rem]">
          <div
            class="glow-orb absolute left-1/2 top-2 -z-10 aspect-square w-[95%] -translate-x-1/2 rounded-full blur-2xl"
            aria-hidden="true"
          >
          </div>
          <img
            src="/images/leopoldo-cutout.webp"
            alt={profile.name}
            width="768"
            height="1024"
            class="hero-cutout h-auto w-full select-none"
          />
        </div>
        <p class="mt-4 text-center font-mono text-[11px] uppercase tracking-widest text-muted md:text-right">
          SYS_ID: LM-WIC-01 · 52.9808°N 6.0446°W
        </p>
      </div>
    </div>
  </div>

  <div class="relative mx-auto max-w-6xl border-t border-border px-6 py-10">
    <p class="mb-5 font-mono text-xs uppercase tracking-widest text-muted">Companies I've worked with</p>
    <div class="flex flex-wrap gap-3">
      {
        companies.map((company) => (
          <div
            class={`flex h-16 items-center justify-center rounded-sm border border-border px-6 ${
              company.card === "light" ? "bg-white" : "bg-surface"
            }`}
          >
            <img
              src={company.src}
              alt={company.name}
              width={company.w}
              height={company.h}
              class={`w-auto object-contain ${company.imgClass}`}
            />
          </div>
        ))
      }
      <div class="flex h-16 items-center justify-center rounded-sm border border-border bg-surface px-6">
        <span class="font-sans text-sm tracking-wide text-ink">
          <span class="font-bold">SYNCRO</span> WEB
        </span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-cutout {
    -webkit-mask-image: linear-gradient(to bottom, black 90%, transparent 100%);
    mask-image: linear-gradient(to bottom, black 90%, transparent 100%);
  }

  /* Deliberate exception to the "no gradients" rule — see docs/design_system.md */
  .glow-orb {
    background: radial-gradient(
      circle at center,
      rgba(228, 87, 46, 0.55) 0%,
      rgba(228, 87, 46, 0.28) 45%,
      rgba(228, 87, 46, 0) 72%
    );
  }
</style>
