---
import { profile } from "@/content/profile";
import Button from "@/components/ui/Button.astro";
import Metric from "@/components/ui/Metric.astro";
import TechPill from "@/components/ui/TechPill.astro";

const heroTags = ["Java", "Python", "OpenTelemetry", "Distributed Tracing"];
const firstName = profile.name.split(" ")[0];
---

<section id="top" class="relative overflow-hidden border-b border-border">
  <svg
    class="pointer-events-none absolute inset-0 hidden h-full w-full opacity-[0.07] md:block"
    aria-hidden="true"
  >
    <line x1="0" y1="18%" x2="52%" y2="18%" stroke="white" stroke-width="1"></line>
    <line x1="0" y1="38%" x2="78%" y2="38%" stroke="white" stroke-width="1"></line>
    <line x1="0" y1="58%" x2="38%" y2="58%" stroke="#E4572E" stroke-width="1"></line>
    <line x1="0" y1="78%" x2="64%" y2="78%" stroke="white" stroke-width="1"></line>
  </svg>

  <div class="relative mx-auto max-w-6xl px-6 pb-14 pt-16 md:pb-20 md:pt-24">
    <div class="grid gap-16 md:grid-cols-[1.2fr_0.8fr] md:items-center">
      <div>
        <p class="mb-5 flex items-center gap-2 font-mono text-xs uppercase tracking-widest text-muted">
          <span class="h-1.5 w-1.5 rounded-full bg-ember"></span>
          {profile.location} — Distributed systems & observability
        </p>
        <h1 class="font-display text-4xl font-semibold leading-[1.05] tracking-tight text-ink sm:text-5xl md:text-6xl">
          Backend systems that stay <span class="text-ember">observable</span> at scale.
        </h1>
        <p class="mt-6 max-w-xl text-base leading-relaxed text-muted md:text-lg">
          I'm {firstName}, a {profile.title.toLowerCase()} specializing in distributed systems performance, API
          architecture and production observability.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <Button href="#work" variant="primary">View selected work</Button>
          <Button href="/resume.pdf" variant="secondary" download>Download resume</Button>
        </div>
        <div class="mt-8 flex flex-wrap gap-x-4 gap-y-2 border-t border-border pt-6">
          {heroTags.map((tag) => <TechPill label={tag} />)}
        </div>
      </div>

      <div class="justify-self-center md:justify-self-end">
        <div class="relative h-72 w-72">
          <!-- Orbit ring -->
          <svg
            class="pointer-events-none absolute inset-0 hidden h-full w-full md:block"
            viewBox="0 0 288 288"
            fill="none"
            aria-hidden="true"
          >
            <circle cx="144" cy="144" r="140" stroke="rgba(255,255,255,0.14)" stroke-width="1" stroke-dasharray="1 7"
            ></circle>
            <circle
              cx="144"
              cy="144"
              r="140"
              stroke="#E4572E"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-dasharray="145 875"
              stroke-dashoffset="-30"
              transform="rotate(-90 144 144)"></circle>
          </svg>

          <!-- Rotating "available for work" badge -->
          <div class="absolute -right-3 -top-3 z-10 hidden h-24 w-24 md:block" aria-hidden="true">
            <svg viewBox="0 0 100 100" class="h-full w-full animate-orbit">
              <defs>
                <path id="badge-ring" d="M 50,50 m -38,0 a 38,38 0 1,1 76,0 a 38,38 0 1,1 -76,0"></path>
              </defs>
              <circle cx="50" cy="50" r="38" fill="none" stroke="rgba(255,255,255,0.16)" stroke-width="0.6"></circle>
              <text class="font-mono" font-size="6.4" letter-spacing="2.6" fill="#A29A8D">
                <textPath href="#badge-ring" startOffset="0%">AVAILABLE FOR WORK · AVAILABLE FOR WORK ·</textPath>
              </text>
            </svg>
            <span class="absolute inset-0 m-auto flex h-2.5 w-2.5 items-center justify-center">
              <span class="absolute h-2.5 w-2.5 animate-ping rounded-full bg-ember opacity-60"></span>
              <span class="relative h-1.5 w-1.5 rounded-full bg-ember"></span>
            </span>
          </div>

          <!-- Full circular portrait, concentric with the orbit ring -->
          <div class="absolute inset-6 overflow-hidden rounded-full border border-border-strong bg-surface">
            <img
              src="/images/leopoldo-headshot.webp"
              alt={profile.name}
              width="640"
              height="640"
              class="h-full w-full object-cover"
            />
          </div>
        </div>
        <p class="mt-3 text-center font-mono text-[11px] uppercase tracking-widest text-muted md:text-right">
          SYS_ID: LM-DUB-01 · 53.3498°N 6.2603°W
        </p>
      </div>
    </div>
  </div>

  <div class="relative mx-auto max-w-6xl border-t border-border px-6 py-8">
    <div class="grid grid-cols-1 gap-8 sm:grid-cols-3">
      {profile.metrics.map((metric) => <Metric value={metric.value} label={metric.label} />)}
    </div>
  </div>
</section>
