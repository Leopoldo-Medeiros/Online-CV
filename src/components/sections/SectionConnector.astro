---
// A single soft signal sweep straddling the seam between the hero's metrics
// and "01 — About" — quiet, curved, almost invisible, with one ember segment
// near its end. Zero-height wrapper: overlays the seam without adding extra
// vertical rhythm to the page.
---

<div class="relative z-10 mx-auto hidden h-0 max-w-6xl px-6 md:block" aria-hidden="true">
  <svg
    class="pointer-events-none absolute -top-14 left-0 h-28 w-full"
    viewBox="0 0 1104 112"
    fill="none"
    preserveAspectRatio="none"
  >
    <path
      d="M 1080 18 C 820 10, 420 70, 56 96"
      stroke="rgba(255,255,255,0.09)"
      stroke-width="1"
      stroke-linecap="round"
      fill="none"></path>
    <path
      d="M 300 56 C 200 70, 120 88, 56 96"
      stroke="#E4572E"
      stroke-width="1.25"
      stroke-linecap="round"
      fill="none"
      opacity="0.6"></path>
    <circle cx="56" cy="96" r="2.5" fill="#E4572E" opacity="0.85"></circle>
  </svg>
</div>
