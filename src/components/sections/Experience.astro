---
import { profile } from "@/content/profile";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import TechPill from "@/components/ui/TechPill.astro";
---

<section id="experience" class="border-b border-border py-20 md:py-28">
  <div class="mx-auto max-w-6xl px-6">
    <SectionHeading index="04" eyebrow="Experience" heading="Where the systems above were built." />

    <div class="flex flex-col divide-y divide-border">
      {
        profile.experience.map((role) => (
          <div class="grid gap-4 py-8 first:pt-0 last:pb-0 md:grid-cols-[1fr_2.4fr] md:gap-10">
            <div>
              <p class="font-mono text-xs uppercase tracking-widest text-muted">{role.period}</p>
              <h3 class="mt-1 font-display text-lg font-semibold text-ink">{role.position}</h3>
              <p class="text-sm text-muted">
                {role.company} — {role.location}
              </p>
            </div>
            <div>
              <ul class="space-y-2 text-justify text-sm leading-relaxed text-muted">
                {role.highlights.map((highlight) => (
                  <li class="flex gap-3">
                    <span class="mt-2 h-1 w-1 flex-shrink-0 rounded-full bg-ember"></span>
                    <span>{highlight}</span>
                  </li>
                ))}
              </ul>
              <div class="mt-4 flex flex-wrap gap-2">
                {role.skills.map((skill) => <TechPill label={skill} />)}
              </div>
              {role.projects && (
                <div class="mt-4 flex flex-wrap gap-3">
                  {role.projects.map((proj) =>
                    proj.status === "live" ? (
                      <a
                        href={proj.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="block w-full max-w-xs overflow-hidden border border-border transition-colors hover:border-ember/50"
                      >
                        <img
                          src={proj.src}
                          alt={proj.alt}
                          width="960"
                          height="600"
                          class="h-auto w-full object-cover"
                        />
                        <span class="flex items-center justify-between border-t border-border px-3 py-2 font-mono text-[11px] uppercase tracking-widest text-muted">
                          {proj.name}
                          <span aria-hidden="true">→</span>
                        </span>
                      </a>
                    ) : (
                      <div class="w-full max-w-xs overflow-hidden border border-border">
                        {proj.src && (
                          <img
                            src={proj.src}
                            alt={proj.alt}
                            width="960"
                            height="460"
                            class="h-auto w-full object-cover opacity-80"
                          />
                        )}
                        <div class="p-3">
                          <div class="flex items-center justify-between gap-2">
                            <span class="font-mono text-[11px] uppercase tracking-widest text-muted">
                              {proj.name}
                            </span>
                            <span class="flex items-center gap-1.5 font-mono text-[10px] uppercase tracking-widest text-ember">
                              <span class="h-1 w-1 rounded-full bg-ember" />
                              In progress
                            </span>
                          </div>
                          <p class="mt-2 text-xs leading-relaxed text-muted">{proj.description}</p>
                        </div>
                      </div>
                    ),
                  )}
                </div>
              )}
            </div>
          </div>
        ))
      }
    </div>

    <div class="mt-14 border-t border-border pt-8">
      <p class="mb-4 font-mono text-xs uppercase tracking-widest text-muted">Education</p>
      {
        profile.education.map((edu) => (
          <div>
            <h3 class="font-display text-lg font-semibold text-ink">{edu.degree}</h3>
            <p class="text-sm text-muted">
              {edu.institution} — {edu.location} · {edu.period}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
