---
const links = [
  { href: "#about", label: "About" },
  { href: "#work", label: "Work" },
  { href: "#experience", label: "Experience" },
  { href: "#contact", label: "Contact" },
];
---

<header class="sticky top-0 z-50 border-b border-border bg-bg/90 backdrop-blur">
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
    <a
      href="#top"
      class="relative flex h-9 w-9 items-center justify-center rounded-sm border border-border-strong"
      aria-label="Back to top"
    >
      <span class="font-display text-lg font-extrabold leading-none tracking-tighter">
        <span class="text-ember">L</span><span class="text-ink">M</span>
      </span>
      <span class="absolute right-[7px] top-[7px] h-1 w-1 rounded-full bg-ember" aria-hidden="true"></span>
    </a>
    <ul class="hidden gap-8 font-mono text-xs uppercase tracking-widest text-muted md:flex">
      {
        links.map((link) => (
          <li>
            <a href={link.href} class="transition-colors hover:text-ink">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
    <a
      href="#contact"
      class="rounded-sm border border-border-strong px-4 py-2 font-mono text-xs uppercase tracking-widest text-ink transition-colors hover:border-ember hover:text-ember"
    >
      Get in touch
    </a>
  </nav>
</header>
