---
import { profile } from "@/content/profile";
import SectionHeading from "@/components/ui/SectionHeading.astro";
---

<section id="about" class="border-b border-border py-20 md:py-28">
  <div class="mx-auto max-w-6xl px-6">
    <SectionHeading index="01" eyebrow="About" heading="Backend-first, observability-obsessed." />
    <div class="grid gap-10 md:grid-cols-[0.9fr_1.1fr] md:gap-16">
      <p class="text-justify text-base leading-relaxed text-muted md:text-lg">{profile.summary}</p>
      <div class="flex flex-col divide-y divide-border">
        {
          profile.capabilities.map((capability) => (
            <div class="py-5 first:pt-0 last:pb-0">
              <p class="font-mono text-xs text-ember">{capability.index}</p>
              <h3 class="mt-2 font-display text-lg font-semibold text-ink">{capability.title}</h3>
              <p class="mt-2 text-justify text-sm leading-relaxed text-muted">{capability.description}</p>
              {capability.details && (
                <ul class="mt-3 space-y-1.5">
                  {capability.details.map((detail) => (
                    <li class="flex items-baseline gap-2 text-sm text-muted">
                      <span class="h-1 w-1 flex-shrink-0 translate-y-[-2px] rounded-full bg-ember" />
                      {detail}
                    </li>
                  ))}
                </ul>
              )}
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
