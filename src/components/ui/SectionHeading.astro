---
interface Props {
  index: string;
  eyebrow: string;
  heading: string;
}

const { index, eyebrow, heading } = Astro.props;
---

<div class="mb-10 md:mb-14">
  <p class="mb-3 font-mono text-xs uppercase tracking-widest text-ember">{index} — {eyebrow}</p>
  <h2 class="font-display text-3xl font-semibold tracking-tight text-ink md:text-4xl">{heading}</h2>
</div>
