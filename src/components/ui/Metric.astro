---
interface Props {
  value: string;
  label: string;
}

const { value, label } = Astro.props;
---

<div class="flex flex-col gap-1">
  <span class="font-display text-4xl font-semibold text-ink md:text-5xl">{value}</span>
  <span class="font-mono text-xs uppercase tracking-widest text-muted">{label}</span>
</div>
