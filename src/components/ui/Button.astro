---
interface Props {
  href: string;
  variant?: "primary" | "secondary";
  external?: boolean;
  download?: boolean;
}

const { href, variant = "primary", external = false, download = false } = Astro.props;

const base =
  "inline-flex items-center gap-2 rounded-sm px-5 py-3 font-mono text-xs uppercase tracking-widest transition-colors";
const styles =
  variant === "primary"
    ? "bg-ember text-bg hover:bg-ember-dim"
    : "border border-border-strong text-ink hover:border-ember hover:text-ember";
---

<a
  href={href}
  class={`${base} ${styles}`}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
  download={download ? true : undefined}
>
  <slot />
</a>
